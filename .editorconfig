# EditorConfig helps you maintain consistent coding styles
# across different editors and IDEs

# Default language settings
[*]
root = true

# Global settings
[*]
end_of_line = lf
charset = utf-8
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Python settings
[*.py]
indent_size = 4

# YAML settings
[*.yaml]
indent_size = 2

# JSON settings
[*.json]
indent_size = 2

# Shell settings
[*.sh]
indent_size = 2

# TOML settings
[*.toml]
indent_size = 2